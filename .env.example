# .env file template for ServiceLink
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database Configuration
# For development (SQLite is used by default)
# For production, uncomment and configure PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/servicelink

# Email Configuration (Optional - for future notifications)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-email-password

# Session Configuration
PERMANENT_SESSION_LIFETIME=86400

# Logging
# LOG_TO_STDOUT=True
